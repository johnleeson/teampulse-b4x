#Region  Project Attributes
	#ApplicationLabel: TeamPulse
	#Version: 1.0.6
	#iPhoneOrientations: Portrait
	#iPadOrientations: Portrait
	#Target: iPhone, iPad
	#ATSEnabled: True
	#MinVersion: 16
	#PlistExtra: <key>NSPhotoLibraryUsageDescription</key><string>Attach a photo to a match event.</string>
#End Region

Sub Process_Globals
	Public App As Application
	Public NavControl As NavigationController
	Public hd As HUD
End Sub

Private Sub Application_Start (Nav As NavigationController)
	NavControl = Nav
	Dim PagesManager As B4XPagesManager
	PagesManager.Initialize(NavControl)
	NavControl.NavigationBarVisible = False
End Sub

'Template version: B4i-1.00
#Region  Delegates

Private Sub Application_Background
	modPlatform.BeginBackgroundTask
	modLocal.PersistSnapshot
	B4XPages.Delegate.Activity_Pause
	Try
		CallSub(B4XPages.MainPage, "NoteBackgroundSync")
		CallSubDelayed(B4XPages.MainPage, "KickSync")
	Catch
		Log("Background sync: " & LastException)
		Try
			CallSub(B4XPages.MainPage, "CancelBackgroundHold")
		Catch
			Log("CancelBackgroundHold: " & LastException)
		End Try
		modPlatform.EndBackgroundTask
	End Try
End Sub

Private Sub Application_Foreground
	B4XPages.Delegate.Activity_Resume
	Try
		CallSubDelayed(B4XPages.MainPage, "KickSync")
	Catch
		Log("Foreground sync: " & LastException)
	End Try
End Sub

#End Region
