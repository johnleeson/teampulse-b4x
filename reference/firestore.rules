
// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: profiles
// Document ID: userId
// Fields:
//   - name: string (required)
//   - avatar: string (optional)
//   - roles: list (optional)
//
// Collection: clubs
// Document ID: clubId
// Fields:
//   - name: string (required)
//   - logo: string (optional)
//   - description: string (optional)
//   - type: string (optional)
//   - ownerId: string (required)
//   - inviteCode: string (required)
//
// Collection: club_members
// Document ID: clubId_userId
// Fields:
//   - clubId: string (required)
//   - userId: string (required)
//   - roles: list (required)
//
// Collection: matches
// Document ID: matchId
// Fields:
//   - clubId: string (required)
//   - title: string (required)
//   - date: string (required)
//   - meetTime: string
//   - kickOffTime: string
//   - location: string
//   - status: string (required)
//   - scoreA: number
//   - scoreB: number
//   - signedUpPlayerIds: list
//   - availability: map
//   - opponentName: string
//   - isHome: bool
//   - potmVotes: map
//   - aiSummary: string
//
// Collection: feed_events
// Document ID: eventId
// Fields:
//   - matchId: string (required)
//   - userId: string (required)
//   - userName: string (required)
//   - type: string (required)
//   - timestamp: timestamp (required)
//   - content: string
//   - details: map
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.roles.hasAny(['ADMIN']) ||
         (request.auth.token.email == "leesonjohn.JL@gmail.com" && request.auth.token.email_verified == true) ||
         (request.auth.token.email == "john.leeson@enodoit.co.uk" && request.auth.token.email_verified == true));
    }

    function isClubAdmin(clubId) {
      let memberPath = /databases/$(database)/documents/club_members/$(clubId + "_" + request.auth.uid);
      return isAuthenticated() && 
             (exists(memberPath) && get(memberPath).data.roles.hasAny(['ADMIN']) || 
              (exists(/databases/$(database)/documents/clubs/$(clubId)) && get(/databases/$(database)/documents/clubs/$(clubId)).data.ownerId == request.auth.uid));
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidProfile(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             (!('avatar' in data) || data.avatar == null || (data.avatar is string && data.avatar.size() < 1048576)) &&
             (!('roles' in data) || data.roles is list) &&
             (!('age' in data) || data.age == null || (data.age is string && data.age.size() < 50)) &&
             (!('gender' in data) || data.gender == null || (data.gender is string && data.gender.size() < 50)) &&
             (!('favPosition' in data) || data.favPosition == null || (data.favPosition is string && data.favPosition.size() < 100)) &&
             (!('kitSize' in data) || data.kitSize == null || (data.kitSize is string && data.kitSize.size() < 50));
    }

    function isValidClub(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.ownerId is string &&
             data.inviteCode is string && data.inviteCode.size() > 0 &&
             (!('ageGroup' in data) || (data.ageGroup is string && data.ageGroup.size() < 50)) &&
             (!('gender' in data) || (data.gender is string && data.gender.size() < 20)) &&
             (!('teamPhoto' in data) || (data.teamPhoto is string && data.teamPhoto.size() < 1048576));
    }

    function isValidMatch(data) {
      return data.clubId is string &&
             data.title is string && data.title.size() > 0 &&
             data.date is string &&
             data.status is string;
    }

    function isValidFeedEvent(data) {
      return data.matchId is string &&
             data.userId is string &&
             data.userName is string &&
             data.type is string &&
             data.timestamp is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidProfile(request.resource.data);
      allow update: if isAuthenticated() && isValidProfile(request.resource.data);
    }

    match /clubs/{clubId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidClub(request.resource.data) && request.resource.data.ownerId == request.auth.uid;
      allow update: if (isClubAdmin(clubId) || isAdmin()) && isValidClub(request.resource.data);
      allow delete: if (isClubAdmin(clubId) || isAdmin());
    }

    match /club_members/{memberId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (isClubAdmin(request.resource.data.clubId) || isAdmin());
      allow delete: if isAuthenticated() && (isClubAdmin(resource.data.clubId) || isAdmin());
    }

    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidMatch(request.resource.data) && isClubAdmin(request.resource.data.clubId);
      allow update: if isAuthenticated() && isValidMatch(request.resource.data); // Allow players to sign up
      allow delete: if isAuthenticated() && isClubAdmin(resource.data.clubId);
    }

    match /feed_events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidFeedEvent(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidFeedEvent(request.resource.data);
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /test/connection {
      allow read: if true;
    }
  }
}
